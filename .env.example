# ==========================================
# BACKEND ENVIRONMENT VARIABLES (RENDER)
# ==========================================

# Server Port
PORT=8081

# Database Configuration (MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/document_analyzer?createDatabaseIfNotExist=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=bgb@2004

# Spring AI / Ollama Configuration
SPRING_AI_OLLAMA_BASE_URL=http://localhost:11434
SPRING_AI_OLLAMA_CHAT_MODEL=llama3.2
SPRING_AI_OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Vector Store (ChromaDB) Configuration
SPRING_AI_VECTORSTORE_CHROMA_CLIENT_HOST=http://localhost
SPRING_AI_VECTORSTORE_CHROMA_CLIENT_PORT=8000

# CORS Origins (Comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (VERCEL)
# ==========================================

# Base URL of the deployed Spring Boot backend
VITE_API_BASE_URL=https://your-backend.onrender.com
